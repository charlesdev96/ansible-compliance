<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Ubuntu Compliance Report - {{ inventory_hostname }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 2rem; color: #222; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 0.65rem; text-align: left; }
    th { background: #eee; }
    .COMPLIANT { color: #18733b; font-weight: bold; }
    .NON_COMPLIANT { color: #b42318; font-weight: bold; }
    .REVIEW { color: #8a5a00; font-weight: bold; }
  </style>
</head>
<body>
  <h1>Ubuntu Compliance Report</h1>
  <p><strong>Host:</strong> {{ inventory_hostname }}</p>
  <p><strong>Generated:</strong> {{ ansible_date_time.iso8601 }}</p>
  <table>
    <thead><tr><th>Control ID</th><th>Category</th><th>Control</th><th>Status</th><th>Details</th></tr></thead>
    <tbody>
    {% for result in compliance_results %}
      <tr>
        <td>{{ result.id }}</td>
        <td>{{ result.category }}</td>
        <td>{{ result.title }}</td>
        <td class="{{ result.status }}">{{ result.status }}</td>
        <td>{{ result.detail }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</body>
</html>
